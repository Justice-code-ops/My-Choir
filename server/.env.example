NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/voice_of_light
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
MONTHLY_DUE=500
CLIENT_URL=https://your-netlify-site.netlify.app
PUBLIC_APP_URL=https://your-netlify-site.netlify.app
CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
ORGANIZATION_NAME=Voice of Light Chorale
CHURCH_NAME=Voice of Light Church
ORGANIZATION_EMAIL=voxluminachorale@gmail.com
ORGANIZATION_PHONE=
ORGANIZATION_LOCATION=
ORGANIZATION_TAGLINE=
ORGANIZATION_DESCRIPTION=
ORGANIZATION_FACEBOOK=
ORGANIZATION_INSTAGRAM=
ORGANIZATION_YOUTUBE=
ORGANIZATION_TWITTER=

# Optional Cloudinary upload provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset email provider. For Gmail, use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=voxluminachorale@gmail.com
SMTP_PASS=replace-with-gmail-app-password
SMTP_FROM=Voice of Light Chorale <voxluminachorale@gmail.com>

# Payment provider keys
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
