NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/voice_of_light
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
MONTHLY_DUE=500
CLIENT_URL=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
ORGANIZATION_NAME=Voice of Light Chorale
CHURCH_NAME=Voice of Light Church
ORGANIZATION_EMAIL=info@voiceoflight.local
ORGANIZATION_PHONE=
ORGANIZATION_LOCATION=
ORGANIZATION_TAGLINE=
ORGANIZATION_DESCRIPTION=
ORGANIZATION_FACEBOOK=
ORGANIZATION_INSTAGRAM=
ORGANIZATION_YOUTUBE=
ORGANIZATION_TWITTER=

# Optional Cloudinary upload provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Future mail/payment providers
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
